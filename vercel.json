{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/index.html", "destination": "/frontend/index.html" },
    { "source": "/shop", "destination": "/frontend/shop.html" },
    { "source": "/shop.html", "destination": "/frontend/shop.html" },
    { "source": "/adminbala", "destination": "/frontend/adminbala.html" },
    { "source": "/adminbala.html", "destination": "/frontend/adminbala.html" },
    { "source": "/admin", "destination": "/frontend/adminbala.html" },
    { "source": "/admin.html", "destination": "/frontend/adminbala.html" },
    { "source": "/:path*", "destination": "/frontend/:path*" }
  ]
}
